      "destination": "https://aezmo.com/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "tech-fintech-creators.vercel.app" }],
      "destination": "https://aezmo.com/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "ai-creator-management.vercel.app" }],
      "destination": "https://aezmo.com/$1",
      "permanent": true
    }
  ]
}
